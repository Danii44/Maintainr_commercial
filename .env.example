# Public URL for the separately deployed Maintainr SaaS product.
# Example: https://app.your-maintainr-domain.com
VITE_SAAS_APP_URL=

# Server-only PostgreSQL URL for the separate commercial-site quotation and demo database.
# Do not use the SaaS DATABASE_URL here. This database must contain only commercial/demo tables.
COMMERCIAL_DATABASE_URL=

# Server-only, public-to-demo default password used only by `pnpm demo:setup`.
# This must differ from every production password and must never be used by the live SaaS.
DEMO_DEFAULT_PASSWORD=

# Run `pnpm demo:reset` only against the commercial/demo database to restore the safe seeded demo data.

# Set automatically by Netlify for deployed functions; listed for clarity only.
NODE_ENV=production
